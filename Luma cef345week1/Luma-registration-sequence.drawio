        <mxCell id="fail" value="[Event closed / deadline passed / full / duplicate]&#xa;Service rolls back; controller returns 409 with reason; browser shows message." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#d98278;" vertex="1" parent="alt"><mxGeometry x="35" y="55" width="600" height="95" as="geometry"/></mxCell>
        <mxCell id="success" value="[Event accepts registration]&#xa;Service saves registration and unique ticket in the transaction, then commits. Controller returns 201 and browser shows ticket confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#effaf6;strokeColor=#6caa98;" vertex="1" parent="alt"><mxGeometry x="675" y="55" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="note" value="The transaction prevents a registration without its ticket. A unique (event_id, normalized_contact) constraint protects against simultaneous duplicate submissions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9eef5;strokeColor=#aab7c4;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="1400" height="55" as="geometry"/></mxCell>
